# Google Gemini API Key
# Dapatkan API key dari: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Maiarouter API Configuration
VITE_MAIAROUTER_API_KEY=your_maiarouter_api_key_here
VITE_MAIAROUTER_URL=https://api.maiarouter.ai/v1/chat/completions

# Midtrans Payment Gateway (Client Key for frontend)
# Dapatkan dari: Midtrans Dashboard -> Settings -> Access Keys
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Supabase Configuration
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===== BACKEND SECRETS (Set via Supabase Secrets) =====
# ⚠️ JANGAN simpan di .env file! Security risk!
# Set via Supabase Dashboard atau CLI:
#
# CATATAN: Setelah Midtrans production approval:
# - Semua key TIDAK lagi pakai prefix 'SB-'
# - Sandbox key: Mid-client-xxxxx (nomor beda, untuk testing)
# - Production key: Mid-client-yyyyy (nomor beda, untuk live payment)
# - Kedua key format sama (Mid-) tapi NOMOR BERBEDA
#
# Contoh:
# - Sandbox Client: Mid-client-W4qSN0B-zyY2x_dN
# - Production Client: Mid-client-10LU0ymSujDEl4Hi
# - Sandbox Server: Mid-server-aaaaaaaaaaa
# - Production Server: Mid-server-bbbbbbbbbbb
#
# Via CLI:
# supabase secrets set IS_PRODUCTION=false
# supabase secrets set SB_SERVER_KEY=Mid-server-aaaaa (sandbox, tanpa SB- prefix)
# supabase secrets set SB_CLIENT_KEY=Mid-client-xxxxx (sandbox, tanpa SB- prefix)
# supabase secrets set PROD_SERVER_KEY=Mid-server-bbbbb (production)
# supabase secrets set PROD_CLIENT_KEY=Mid-client-yyyyy (production)
#
# Via Dashboard:
# Supabase Dashboard → Settings → Edge Functions → Secrets
#
# Secrets yang dibutuhkan:
# - IS_PRODUCTION (false untuk testing, true untuk production)
# - SB_SERVER_KEY (Sandbox server key - nomor beda dari production)
# - SB_CLIENT_KEY (Sandbox client key - nomor beda dari production)
# - PROD_SERVER_KEY (Production server key - nomor beda dari sandbox)
# - PROD_CLIENT_KEY (Production client key - nomor beda dari sandbox)
#
# Switch environment dengan mengubah IS_PRODUCTION:
# - false: Pakai sandbox key + sandbox URL
# - true: Pakai production key + production URL
