# Google Gemini API Key
# Dapatkan API key dari: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Maiarouter API Configuration
VITE_MAIAROUTER_API_KEY=your_maiarouter_api_key_here
VITE_MAIAROUTER_URL=https://api.maiarouter.ai/v1/chat/completions

# Midtrans Payment Gateway (Client Key for frontend)
# Dapatkan dari: Midtrans Dashboard -> Settings -> Access Keys
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Supabase Configuration
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===== BACKEND SECRETS (Set via Supabase Secrets) =====
# Jangan simpan di .env file!
# Set via: npx supabase secrets set MIDTRANS_SERVER_KEY=your_key
# 
# MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
