# Supabase Configuration (REQUIRED)
# Get these from: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Local Backend API (for payment processing)
# Default: http://localhost:3000 if not set
VITE_BACKEND_API_URL=http://localhost:3000

# Midtrans Configuration (REQUIRED for payments)
# Get these from: Midtrans Dashboard > Settings > Access Keys
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key

