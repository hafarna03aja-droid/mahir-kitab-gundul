{
  "name": "mahir-arab-gundul",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Platform pembelajaran Bahasa Arab berbasis AI dengan fitur analisis gramatikal, kitab digital, dan tutor audio interaktif",
  "author": "24 Learning Centre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/mahir-arab-gundul.git"
  },
  "keywords": [
    "arabic",
    "learning",
    "education",
    "ai",
    "grammar",
    "nahwu",
    "sharaf",
    "kitab"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/inject-env.js",
    "build:cloudflare": "tsc && vite build && node scripts/inject-env.js && copy _worker.js dist\\_worker.js",
    "preview": "vite preview",
    "deploy:check": "powershell -ExecutionPolicy Bypass -File ./deploy-check.ps1",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist --project-name mahir-arab-gundul"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@google/generative-ai": "^0.24.1",
